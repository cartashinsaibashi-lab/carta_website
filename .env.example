# PokerLens API 接続設定(ローカルは .env にコピー。.env はコミットしない)
# 本番は Netlify のダッシュボード or `netlify env:set` で設定する。

# 動作モード: mock | live
#   mock … 認証情報が無くても fixtures で動く(フロント/変換層の開発用)
#   live … 実 API に接続。下の OAuth 認証情報が必須。
POKERLENS_MODE=mock

# API ベース URL(resource)
POKERLENS_BASE_URL=https://api.pokerlens.net

# ============================================================
# 認証:OAuth2 client_credentials
#   POST {TOKEN_URL} で access_token(JWT)を取得し、resource に付与する。
# ============================================================

# トークンエンドポイント(認可サーバー)
POKERLENS_TOKEN_URL=https://identity.pokerlens.net/connect/token

# client_id … Web API Service 連携のクライアント ID(★要確認:コンソール or ベンダー)
POKERLENS_CLIENT_ID=

# client_secret … 管理コンソール Integration「kHold'em Key」の Key
POKERLENS_CLIENT_SECRET=

# scope … resource が要求するスコープ(★要確認。既定 'api')
POKERLENS_SCOPE=api

# 取得した JWT を resource に付けるヘッダ。既定は access_token に生値。
# Bearer 方式にするなら以下を設定:
#   POKERLENS_AUTH_HEADER=Authorization
#   POKERLENS_AUTH_PREFIX=Bearer␣   (末尾に半角スペース)
POKERLENS_AUTH_HEADER=access_token
POKERLENS_AUTH_PREFIX=

# wolf / utage / other の分類(league 名の部分一致。カンマ区切り)
POKERLENS_CATEGORY_WOLF=wolf,ウルフ
POKERLENS_CATEGORY_UTAGE=utage,宴

# ============================================================
# 大会写真(Google Drive)
#   PokerLens に大会写真を持つ仕組みが無いため、写真は Drive から読む。
#   両方が揃っていない場合は「写真 0 枚」として動く(サイトは正常に表示される)。
#   取得手順は docs/getting-credentials.md の「大会写真(Google Drive)」を参照。
# ============================================================

# Drive API を有効にした Google Cloud プロジェクトの API キー(AIza… )。
# API の制限は Google Drive API のみに絞る。アプリケーションの制限は「なし」
# (Netlify Functions は送信元 IP が固定されず、リファラー制限もサーバー間通信では効かない)。
GOOGLE_API_KEY=

# 写真の親フォルダ ID。「リンクを知っている全員が閲覧可」で共有し、
# その直下の種別フォルダ(WOLF / 宴 / 歌留多)に
# 「YYYY-MM-DD #番号 大会名」のフォルダを作って写真を入れてもらう。
# 番号は運営の管理表記(#4 / #SP2 / #S1)でよい — 照合は番号を外した名前でも行う(#82)。
# ID は https://drive.google.com/drive/folders/<ここ>
PHOTO_DRIVE_FOLDER_ID=

# ============================================================
# シリーズランキング(合計ランキング)
#   種別 → ランキングの対応づけ。**空にしておくのが既定**で、そのときは名前一致
#   (下の NAME_* に部分一致するもののうち、登録者 0 名を除いて期間が最も新しいもの)で選ぶ。
#   名前だけで決められないケース(旧版が残っている等)にだけ ID を明示する。
#   ID は POST /v1/ranking/search の結果に出る UUID。
# ============================================================

POKERLENS_RANKING_WOLF=
POKERLENS_RANKING_UTAGE=

# 名前一致に使う語(カンマ区切り)。実データのランキング名は「WOLF 2026 #02」「宴POS ver3」。
POKERLENS_RANKING_NAME_WOLF=wolf,ウルフ
POKERLENS_RANKING_NAME_UTAGE=宴,utage
